[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"

[dependencies]
egui-pop = "{{egui_pop_version}}"
serde_json = "1"

[dev-dependencies]
egui = { version = "{{egui_version}}", features = ["default_fonts"] }
egui_kittest = { version = "{{egui_version}}", features = ["wgpu", "snapshot"] }
egui-pop-test = { version = "{{egui_pop_version}}", features = ["wgpu"] }
