# The tally extension's own text, in French.

plugin-tally =
    .title = Compteur

tally-decrease = Diminuer { $name }
tally-increase = Augmenter { $name }
tally-value = { $name } : { $count }
tally-missing = Le module de comptage n’est pas connecté.

command-tally-increment =
    .title = Augmenter un compteur
    .description = Ajoute un à un compteur (`tally` : son nom).
command-tally-set =
    .title = Régler un compteur
    .description = Donne une valeur à un compteur (`tally` : son nom, `value` : un nombre entier).
