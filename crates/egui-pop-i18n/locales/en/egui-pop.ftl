# egui-pop's own strings and what its plugins declare, in English.
# Generated by `UPDATE_CATALOGUES=1 cargo test -p egui-pop-i18n --test
# catalogues`: do not edit. Translations live in ../<locale>/egui-pop.ftl.

category-edit = Edit

category-editor = Editor

category-file = File

category-help = Help

category-notifications = Notifications

category-values = Values

category-view = View

category-window = Window

command-app-devtools =
    .description = Opens or closes the devtools panel (when the Devtools setting is on).
    .title = Devtools

command-app-fullscreen =
    .description = Fills the screen; the top edge brings the way out back.
    .title = Full screen

command-app-palette =
    .description = Search and run any command.
    .title = Command palette

command-app-quit =
    .description = Close the application.
    .title = Quit

command-app-settings =
    .description = Every setting, searchable, and the keyboard shortcuts.
    .title = Settings

command-app-window-close =
    .description = Closes the window, as its close button does.
    .title = Close window

command-app-window-maximize =
    .description = Maximizes the window, or restores it.
    .title = Maximize

command-app-window-menu =
    .description = Opens the window's menu (restore, minimize, maximize, close).
    .title = Window menu

command-app-window-minimize =
    .description = Minimizes the window.
    .title = Minimize

command-code-actions =
    .description = Asks the assist provider for code actions and quick fixes at the cursor.
    .title = Code actions

command-code-complete =
    .description = Asks the assist provider for completions at the cursor.
    .title = Suggest completions

command-code-definition =
    .description = Asks the assist provider where the symbol at the cursor is defined, and goes there.
    .title = Go to definition

command-code-fold =
    .description = Folds the block at the cursor (or at `line`, from 0).
    .title = Fold

command-code-hover =
    .description = Asks the assist provider about the symbol at the cursor, as hovering does.
    .title = Show hover

command-code-set-diagnostics =
    .description = Replaces a code editor's diagnostics through the `code.diagnostics` step.
    .title = Set the diagnostics

command-code-toggle-breakpoint =
    .description = Sets or clears a breakpoint on the cursor's line (or `line`, from 0).
    .title = Toggle breakpoint

command-code-unfold =
    .description = Unfolds the fold at the cursor (or at `line`, from 0).
    .title = Unfold

command-code-unfold-all =
    .description = Unfolds every fold.
    .title = Unfold all

command-crash-dismiss =
    .description = Deletes a crash report (`path`).
    .title = Delete a crash report

command-crash-reveal =
    .description = Opens a crash report's file (`path`).
    .title = Show a crash report

command-edit-redo =
    .description = Redo the last undone change.
    .title = Redo

command-edit-undo =
    .description = Undo the last change.
    .title = Undo

command-editor-find =
    .description = Opens the search bar; with `query` (and `case_sensitive`, `whole_word`, `regex`), searches and selects the first match after the cursor.
    .title = Find

command-editor-find-next =
    .description = Selects the next match of the search.
    .title = Find next

command-editor-find-previous =
    .description = Selects the previous match of the search.
    .title = Find previous

command-editor-goto-line =
    .description = Opens the go-to-line field; with `line` (from 1), puts the cursor there.
    .title = Go to line

command-editor-read =
    .description = The editor's text (or lines `from_line` to `to_line`, from 0, end excluded), with its version, selection and state.
    .title = Read the text

command-editor-redo =
    .description = Redoes the editor's last undone edit.
    .title = Redo in the editor

command-editor-replace =
    .description = Opens the search bar with replace; with `query` and `replacement`, replaces the match at the cursor (or every match with `all`).
    .title = Replace

command-editor-save =
    .description = Saves the editor's text through the `edit.save` step.
    .title = Save

command-editor-select =
    .description = Selects from `anchor` to `head` (`{"{"}line, col{"}"}` from 0; `head` alone puts the cursor there).
    .title = Select

command-editor-undo =
    .description = Undoes the editor's last edit (its own history, as Ctrl+Z in the editor).
    .title = Undo in the editor

command-editor-write =
    .description = Changes the text through `edit.change`: the whole `text`; or `text` between `from` and `to` (`{"{"}line, col{"}"}` from 0); or a list of `changes`. One undo step.
    .title = Write the text

command-logs-reveal =
    .description = Opens the folder holding the application's log files.
    .title = Show the log folder

command-notify-act =
    .description = Runs a notification's action (`id`, `action`), as a click on it does.
    .title = Act on a notification

command-value-get =
    .description = A value with its descriptor (`path`).
    .title = Read a value

command-value-list =
    .description = The values under a path prefix (`prefix`).
    .title = List values

command-value-redo =
    .description = Redo the last undone change of the store's values.
    .title = Redo

command-value-reset =
    .description = Back to its default (`path`).
    .title = Reset a value

command-value-set =
    .description = `path`; `value`, `step`, `coarse`, `reset`, `top` or `bottom`; `force`, `if_seq`.
    .title = Set a value

command-value-undo =
    .description = Undo the last change of the store's values.
    .title = Undo

command-view-interface-zoom-in =
    .description = Makes the whole interface one step larger.
    .title = Zoom in the interface

command-view-interface-zoom-out =
    .description = Makes the whole interface one step smaller.
    .title = Zoom out the interface

command-view-interface-zoom-reset =
    .description = Gives the interface its normal size.
    .title = Reset the interface zoom

command-view-side-bar-toggle =
    .description = Folds the start side bar to its strip, or unfolds it.
    .title = Fold the side bar

command-workbench-arrangement-reset =
    .description = Puts the panels back as the current arrangement's template has them.
    .title = Reset the arrangement

command-workbench-arrangement-save =
    .description = Saves the panels' places under a name.
    .title = Save the arrangement as...

command-workbench-arrangement-switch =
    .description = Puts the panels as a saved arrangement or a template has them.
    .title = Switch arrangement

