# egui-pop's own strings and what its plugins declare, in English.
# Generated by `UPDATE_CATALOGUES=1 cargo test -p egui-pop-i18n --test
# catalogues`: do not edit. Translations live in ../<locale>/egui-pop.ftl.

category-clipboard = Clipboard

category-dialogs = Dialogs

category-edit = Edit

category-editor = Editor

category-file = File

category-help = Help

category-jobs = Jobs

category-library = Library

category-navigation = Navigation

category-notifications = Notifications

category-pointer = Pointer

category-terminal = Terminal

category-theme = Theme

category-values = Values

category-view = View

category-window = Window

command-app-devtools =
    .description = Opens or closes the devtools panel (when the Devtools setting is on).
    .title = Devtools

command-app-fullscreen =
    .description = Fills the screen; the top edge brings the way out back.
    .title = Full screen

command-app-palette =
    .description = Search and run any command.
    .title = Command palette

command-app-quit =
    .description = Close the application.
    .title = Quit

command-app-settings =
    .description = Every setting, searchable, and the keyboard shortcuts.
    .title = Settings

command-app-settings-page =
    .description = Opens the settings window on a custom page (its id).
    .title = Settings page

command-app-window-close =
    .description = Closes the window, as its close button does.
    .title = Close window

command-app-window-maximize =
    .description = Maximizes the window, or restores it.
    .title = Maximize

command-app-window-menu =
    .description = Opens the window's menu (restore, minimize, maximize, close).
    .title = Window menu

command-app-window-minimize =
    .description = Minimizes the window.
    .title = Minimize

command-clipboard-copy =
    .description = Copies from an endpoint (`source`) into the session's slot (`slot`); `cut` deletes what was copied; `dry_run` says what would be copied and left out.
    .title = Copy from an endpoint

command-clipboard-offers =
    .description = What a slot holds (`slot`): its type, title, formats and revision; with `target`, every way it fits there, each with its preview.
    .title = What the clipboard offers

command-clipboard-paste =
    .description = Pastes the session's slot (`slot`) into an endpoint (`target`), in a `format`, through a `transform`, only some `parts`, checked against `if_rev`; `dry_run` says the plan and the changes without making them.
    .title = Paste into an endpoint

command-clipboard-read =
    .description = A slot's item (`slot`, the session's own by default), payload included; the user's is refused to an agent unless the host allows it.
    .title = Read the clipboard

command-clipboard-write =
    .description = Puts an item in a slot (`slot`, the session's own by default): its `format`, its `data`, a `title`.
    .title = Write the clipboard

command-code-actions =
    .description = Asks the assist provider for code actions and quick fixes at the cursor.
    .title = Code actions

command-code-complete =
    .description = Asks the assist provider for completions at the cursor.
    .title = Suggest completions

command-code-definition =
    .description = Asks the assist provider where the symbol at the cursor is defined, and goes there.
    .title = Go to definition

command-code-fold =
    .description = Folds the block at the cursor (or at `line`, from 0).
    .title = Fold

command-code-hover =
    .description = Asks the assist provider about the symbol at the cursor, as hovering does.
    .title = Show hover

command-code-set-diagnostics =
    .description = Replaces a code editor's diagnostics through the `code.diagnostics` step.
    .title = Set the diagnostics

command-code-toggle-breakpoint =
    .description = Sets or clears a breakpoint on the cursor's line (or `line`, from 0).
    .title = Toggle breakpoint

command-code-unfold =
    .description = Unfolds the fold at the cursor (or at `line`, from 0).
    .title = Unfold

command-code-unfold-all =
    .description = Unfolds every fold.
    .title = Unfold all

command-context-go =
    .description = Goes to a place path (`places`: each `frame` with its `payload`).
    .title = Go to a place

command-context-hold =
    .description = Holds groups of the stack (`groups`, empty: all of it; `place` for places) with a `reason`: transitions touching them are refused until released. Its token.
    .title = Hold the context stack

command-context-read =
    .description = The places and modes on, their revision, the holds and the frames declared, and what the status bar shows (`status`: each visible item's id, text, tone, count and progress, whether it is busy, its error and warning counts, and its hover card).
    .title = Read the context stack

command-context-release =
    .description = Releases a hold of the context stack (`token`).
    .title = Release a hold

command-context-request =
    .description = Asks the owner for a transition (`request`: `op` enter, leave, jump, go, set_mode, push_mode, pop_mode, clear_mode or back), checked against `if_rev`, applied unless `dry_run`.
    .title = Ask for a context transition

command-context-set-mode =
    .description = Sets a mode (`mode`), or pushes it (`push`: true); with `group` and no mode, turns the group off.
    .title = Set a mode

command-crash-dismiss =
    .description = Deletes a crash report (`path`).
    .title = Delete a crash report

command-crash-reveal =
    .description = Opens a crash report's file (`path`).
    .title = Show a crash report

command-dialogs-move =
    .description = Moves the dialog shown with the arrow keys; Enter keeps the place, Escape puts it back.
    .title = Move dialog

command-edit-copy =
    .description = Copy the selection.
    .title = Copy

command-edit-cut =
    .description = Cut the selection: copied once its delete is accepted.
    .title = Cut

command-edit-paste =
    .description = Paste in the richest format the focused element accepts.
    .title = Paste

command-edit-pasteSpecial =
    .description = Choose the format, the transform or the parts to paste, each with its preview.
    .title = Paste special

command-edit-redo =
    .description = Redo the last undone change.
    .title = Redo

command-edit-undo =
    .description = Undo the last change.
    .title = Undo

command-editor-find =
    .description = Opens the search bar; with `query` (and `case_sensitive`, `whole_word`, `regex`), searches and selects the first match after the cursor.
    .title = Find

command-editor-find-next =
    .description = Selects the next match of the search.
    .title = Find next

command-editor-find-previous =
    .description = Selects the previous match of the search.
    .title = Find previous

command-editor-goto-line =
    .description = Opens the go-to-line field; with `line` (from 1), puts the cursor there.
    .title = Go to line

command-editor-read =
    .description = The editor's text (or lines `from_line` to `to_line`, from 0, end excluded), with its version, selection and state.
    .title = Read the text

command-editor-redo =
    .description = Redoes the editor's last undone edit.
    .title = Redo in the editor

command-editor-replace =
    .description = Opens the search bar with replace; with `query` and `replacement`, replaces the match at the cursor (or every match with `all`).
    .title = Replace

command-editor-save =
    .description = Saves the editor's text through the `edit.save` step.
    .title = Save

command-editor-select =
    .description = Selects from `anchor` to `head` (`{"{"}line, col{"}"}` from 0; `head` alone puts the cursor there).
    .title = Select

command-editor-undo =
    .description = Undoes the editor's last edit (its own history, as Ctrl+Z in the editor).
    .title = Undo in the editor

command-editor-write =
    .description = Changes the text through `edit.change`: the whole `text`; or `text` between `from` and `to` (`{"{"}line, col{"}"}` from 0); or a list of `changes`. One undo step.
    .title = Write the text

command-gesture-graph-fit =
    .description = Fits the whole graph in the view.
    .title = Node graph: fit

command-gesture-graph-pan =
    .description = Moves the graph with the wheel or a drag.
    .title = Node graph: pan

command-gesture-graph-pan-x =
    .description = Moves the graph sideways with the wheel.
    .title = Node graph: pan horizontally

command-gesture-graph-pan-y =
    .description = Moves the graph up and down with the wheel.
    .title = Node graph: pan vertically

command-gesture-graph-zoom =
    .description = Zooms the graph around the pointer.
    .title = Node graph: zoom at the pointer

command-gesture-image-fit =
    .description = Fits the whole image in the view.
    .title = Image: fit

command-gesture-image-pan =
    .description = Moves the image with the wheel or a drag.
    .title = Image: pan

command-gesture-image-pan-x =
    .description = Moves the image sideways with the wheel.
    .title = Image: pan horizontally

command-gesture-image-pan-y =
    .description = Moves the image up and down with the wheel.
    .title = Image: pan vertically

command-gesture-image-zoom =
    .description = Zooms the image around the pointer, holding at fit and 100 %.
    .title = Image: zoom at the pointer

command-gesture-image-zoom-cycle =
    .description = Goes to 100 %, then 200 %, then fit, around the pointer.
    .title = Image: zoom cycle

command-gesture-image-zoom-free =
    .description = Zooms the image around the pointer, holding nowhere.
    .title = Image: zoom without stops

command-gesture-image-zoom-toggle =
    .description = Goes to 100 % around the pointer when the image fits, else fits it.
    .title = Image: fit or 100 %

command-gesture-value-coarse =
    .description = These keys make a slider's drag, arrows and wheel ten times coarser.
    .title = Values: coarser

command-gesture-value-fine =
    .description = These keys make a slider's drag, arrows and wheel ten times finer.
    .title = Values: finer

command-gesture-value-panel =
    .description = The wheel with these keys scrolls the panel, even over a slider.
    .title = Values: scroll the panel

command-gesture-value-step =
    .description = The wheel with these keys steps the slider under the pointer, focused or not.
    .title = Values: step with the wheel

command-job-cancel =
    .description = Asks the host to cancel the job `id`; it shows as cancelling until the host says it is cancelled.
    .title = Cancel a job

command-job-pause =
    .description = Asks the host to pause the job `id`.
    .title = Pause a job

command-job-resume =
    .description = Asks the host to resume the paused job `id`.
    .title = Resume a job

command-job-retry =
    .description = Asks the host to run the failed or cancelled job `id` again.
    .title = Retry a job

command-library-filter =
    .description = Sets a library's filter (`filter`: `text`, `min_rating`, `labels`, `flags`, `tags`, `from`, `to`; `{"{"}{"}"}` clears it), through its search field's `library.filter` step.
    .title = Filter images

command-library-flag =
    .description = Picks, rejects or unflags images (`flag`: pick, reject, none): `keys`, else the selection; through `library.flag`.
    .title = Flag images

command-library-label =
    .description = Puts a colour label (`label`: red, yellow, green, blue, purple) on images or takes it off (`on`; else toggled from the cursor's image): `keys`, else the selection; through `library.label`.
    .title = Label images

command-library-rate =
    .description = Rates images (`rating`, 0 to 5) of a library: `keys`, else its selection; through its `library.rate` step.
    .title = Rate images

command-library-select =
    .description = Selects images of a library by key (`keys`, the cursor on `cursor` or the last key), through its `library.select` step.
    .title = Select images

command-library-tag =
    .description = Adds tags (`add`) to images and takes others off (`remove`): `keys`, else the selection; through `library.tag`.
    .title = Tag images

command-logs-reveal =
    .description = Opens the folder holding the application's log files.
    .title = Show the log folder

command-nav-back =
    .description = Pops the last pushed mode, else leaves the place shown for its parent.
    .title = Back

command-nav-enter =
    .description = Enters a place under the one shown (`frame`, `payload`).
    .title = Enter a place

command-nav-up =
    .description = Leaves the place shown for its parent.
    .title = Up to the parent place

command-notify-act =
    .description = Runs a notification's action (`id`, `action`), as a click on it does.
    .title = Act on a notification

command-palettes-reset =
    .description = Puts the floating palettes back where they first open, rolled down and sized by their content.
    .title = Reset palettes

command-palettes-toggle =
    .description = Hides the palettes that are not pinned, or shows them again.
    .title = Hide or show palettes

command-pointer-overrides =
    .description = Keeps the pointer gestures the user changed on the current profile, or drops them (`value`: keep or drop).
    .title = Keep or drop pointer gesture changes

command-status-item-hide =
    .description = Hides a status bar item (`id`) where the user is, or shows it again (`hidden`: false).
    .title = Hide a status item

command-status-item-hover =
    .description = Opens the hover card of a status bar item (`id`; by default the one with the keyboard focus), as hovering it does. Escape closes it.
    .title = Show a status item's card

command-status-item-move =
    .description = Moves a status bar item (`id`) one step towards its start or end (`toward`: start or end), where the user is.
    .title = Move a status item

command-status-item-open =
    .description = Opens the popover of a status bar item (`id`), as a click on it does, or closes it (`open`: false).
    .title = Open a status item

command-terminal-clear =
    .description = Clears the screen and the scrollback (the program goes on).
    .title = Clear the terminal

command-terminal-close =
    .description = Ends the terminal's session through `terminal.exit` (the program is stopped).
    .title = Close the session

command-terminal-copy =
    .description = Copies the terminal's selection to the clipboard.
    .title = Copy the selection

command-terminal-read =
    .description = The terminal's text: its scrollback and screen (or lines `from_line` to `to_line`, from 0, end excluded; `screen` alone for the screen), with the cursor, the size and the session's state.
    .title = Read the terminal

command-terminal-restart =
    .description = Starts the terminal's program again through `terminal.spawn` (closing the running one first).
    .title = Restart

command-terminal-send =
    .description = Sends `text` to the program through `terminal.input` (with `enter`, followed by Enter).
    .title = Send input

command-theme-counterpart =
    .description = The pair's other variant generated from the one edited (colours mirrored: the same hue and saturation, the lightness inverted; aliases and other values as they are): the edits proposed, or, with `apply`, written as one change.
    .title = Generate the other variant

command-theme-export =
    .description = The theme being edited as a .tokens.json file (`name`): $extends its base, the tokens changed with their types; a light and dark pair as one file carrying its counterpart.
    .title = Export the theme

command-theme-generate =
    .description = Writes a scale generated from a seed colour (`seed`, #rrggbb) over one of the theme's colour scales (`scale`): steps 1 to 12 and contrast, for the variant edited, light or dark; undone as one change.
    .title = Generate a colour scale

command-theme-import =
    .description = Loads a .tokens.json file (`text`) into the theme editor, through the theme.load step; says which tokens were left out (`skipped`) and what it loaded with (`warnings`).
    .title = Import a theme

command-theme-read =
    .description = The theme being edited: its base, the tokens changed, the history and the failing contrast pairs; with `path`, one token, its value, alias and contrast readouts.
    .title = Read the theme

command-theme-redo =
    .description = Makes the theme editor's last undone change again.
    .title = Redo a theme change

command-theme-set =
    .description = Sets a token of the theme being edited (`path`, `value`: a raw DTCG value or an alias of another token, null for the base theme's), through the theme.token step; undoable.
    .title = Set a theme token

command-theme-start =
    .description = Starts the theme editor again from a theme (`base`), its history emptied, through the theme.load step.
    .title = Start a theme from

command-theme-switch =
    .description = Edits the other variant, light or dark, of the pair being edited, and shows it; each variant keeps its changes and history.
    .title = Switch the variant edited

command-theme-undo =
    .description = Takes the theme editor's last change back, through the theme.token step.
    .title = Undo a theme change

command-tips-dismiss =
    .description = Dismisses a tip for good (`tip`, its id), through the tips.dismiss step.
    .title = Dismiss a tip

command-tips-list =
    .description = Every tip registered: its id, English title and text, whether it is contextual and whether it was dismissed.
    .title = List the tips

command-tips-reset =
    .description = Forgets which tips were dismissed.
    .title = Show every tip again

command-value-get =
    .description = A value with its descriptor (`path`).
    .title = Read a value

command-value-list =
    .description = The values under a path prefix (`prefix`).
    .title = List values

command-value-redo =
    .description = Redo the last undone change of the store's values.
    .title = Redo

command-value-reset =
    .description = Back to its default (`path`).
    .title = Reset a value

command-value-set =
    .description = `path`; `value`, `step`, `coarse`, `reset`, `top` or `bottom`; `force`, `if_seq`.
    .title = Set a value

command-value-undo =
    .description = Undo the last change of the store's values.
    .title = Undo

command-view-interface-zoom-in =
    .description = Makes the whole interface one step larger.
    .title = Zoom in the interface

command-view-interface-zoom-out =
    .description = Makes the whole interface one step smaller.
    .title = Zoom out the interface

command-view-interface-zoom-reset =
    .description = Gives the interface its normal size.
    .title = Reset the interface zoom

command-view-side-bar-toggle =
    .description = Folds the start side bar to its strip, or unfolds it.
    .title = Fold the side bar

command-view-theme-toggle-light-dark =
    .description = Shows the other variant of the theme, light or dark, when it has one.
    .title = Toggle light and dark theme

command-workbench-arrangement-reset =
    .description = Puts the panels back as the current arrangement's template has them.
    .title = Reset the arrangement

command-workbench-arrangement-save =
    .description = Saves the panels' places under a name.
    .title = Save the arrangement as...

command-workbench-arrangement-switch =
    .description = Puts the panels as a saved arrangement or a template has them.
    .title = Switch arrangement

command-workbench-leave-zen =
    .description = Shows the whole workbench again.
    .title = Leave zen mode

command-workbench-zen =
    .description = Shows the centre alone: no title, menu or status bar, no side or bottom area, no palette. Escape leaves it.
    .title = Zen mode

