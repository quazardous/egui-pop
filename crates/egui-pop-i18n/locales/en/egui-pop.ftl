setting-appearance-interface-zoom-choice-90- = 90%

setting-appearance-language =
    .description = The language of the interface; System follows the system's.
    .label = Language

setting-appearance-language-choice-system = system

setting-appearance-text-size =
    .description = Makes the text larger or smaller, without the spacing (the interface zoom scales everything).
    .label = Text size

setting-appearance-text-size-choice-100- = 100%

setting-appearance-text-size-choice-115- = 115%

setting-appearance-text-size-choice-130- = 130%

setting-appearance-text-size-choice-150- = 150%

setting-appearance-text-size-choice-175- = 175%

setting-appearance-text-size-choice-200- = 200%

setting-appearance-text-size-choice-85- = 85%

setting-appearance-theme-preference =
    .description = Which variant of a theme with a light and a dark one is shown: the system's, or always the light or the dark one. A theme without a counterpart keeps its own.
    .label = Light or dark

setting-appearance-theme-preference-choice-dark = dark

setting-appearance-theme-preference-choice-light = light

setting-appearance-theme-preference-choice-system = system

setting-developer-devtools =
    .description = Lets the devtools panel open (F12): key resolutions, the journal, steps, focus, scale and every debug collector.
    .label = Devtools

setting-developer-log-level =
    .description = How much the application writes to its log file: errors only, up to every detail.
    .label = Log level

setting-developer-log-level-choice-debug = debug

setting-developer-log-level-choice-error = error

setting-developer-log-level-choice-info = info

setting-developer-log-level-choice-trace = trace

setting-developer-log-level-choice-warn = warn

setting-developer-show-keys =
    .description = Shows each text's translation key instead of the text, to find where it comes from.
    .label = Show translation keys

setting-dialogs-closable =
    .description = A ✕ at the right end of each dialog's title row, doing what Escape does.
    .label = Close button on every dialog

setting-dialogs-movable =
    .description = Every dialog has a header band to drag it by; Alt+F7 moves it with the arrow keys.
    .label = Movable dialogs

setting-files-native =
    .description = Choose files with the system's chooser when there is one; off, with egui-pop's own.
    .label = Use the system's file chooser

setting-input-image-double-click =
    .description = What a double click on the image does: fit it, leave the view (back to the browser, as darktable does), or nothing; profile: as the pointer profile says.
    .label = Double click on the image

setting-input-image-double-click-choice-fit = fit

setting-input-image-double-click-choice-leave = leave

setting-input-image-double-click-choice-nothing = nothing

setting-input-image-double-click-choice-profile = profile

setting-input-pointer-profile =
    .description = What the wheel, a pinch and the mouse buttons do on the image, the node graph and sliders, as in darktable, Adobe's applications, document tools (GIMP, Inkscape, the web), Blender and node editors, or on a trackpad. The shortcuts editor shows and changes each gesture.
    .label = Pointer profile

setting-input-pointer-profile-choice-adobe = adobe

setting-input-pointer-profile-choice-blender = blender

setting-input-pointer-profile-choice-darktable = darktable

setting-input-pointer-profile-choice-document = document

setting-input-pointer-profile-choice-trackpad = trackpad

setting-input-slider-wheel =
    .description = Whether the wheel over a slider scrolls the panel (guarded: the slider steps only with the focus or the step keys) or changes the value (value); profile: as the pointer profile says.
    .label = Wheel over sliders

setting-input-slider-wheel-choice-guarded = guarded

setting-input-slider-wheel-choice-profile = profile

setting-input-slider-wheel-choice-value = value

setting-input-wheel-device =
    .description = What sends wheel events: auto tells a mouse wheel (lines) from a trackpad (points); some mice send points too, and choosing mouse or trackpad settles it.
    .label = Wheel device

setting-input-wheel-device-choice-auto = auto

setting-input-wheel-device-choice-mouse = mouse

setting-input-wheel-device-choice-trackpad = trackpad

setting-notifications-desktop =
    .description = Where notifications show: on the desktop, on the desktop only while the window does not have the focus, or in the window.
    .label = Desktop notifications

setting-notifications-desktop-choice-always = always

setting-notifications-desktop-choice-never = never

setting-notifications-desktop-choice-unfocused = unfocused

setting-palettes-fade-on-stroke =
    .description = Palettes fade while a stroke is in progress on the canvas.
    .label = Fade palettes while drawing

setting-palettes-idle-opacity =
    .description = How opaque a palette is while the pointer is elsewhere; 1 keeps it opaque.
    .label = Palette opacity away from the pointer

setting-tips-dismissed =
    .description = The tips not to show again, by id; empty to show them all again.
    .label = Dismissed tips

setting-tips-show =
    .description = The tip of the day and the hints beside what they are about.
    .label = Show tips

setting-window-bar-in-fullscreen =
    .description = Keeps the application's title bar (its buttons and items) in full screen; off, full screen hides it.
    .label = Title bar in full screen

setting-window-frame =
    .description = Who draws the window's title bar and edges: the application (own), or the desktop (system).
    .label = Window frame

setting-window-frame-choice-own = own

setting-window-frame-choice-system = system

setting-workbench-panel-alignment =
    .description = How the bottom panel lines up with the side bars: the whole width (justify), between them (center), under the start one (start) or under the end one (end).
    .label = Panel alignment

setting-workbench-panel-alignment-choice-center = center

setting-workbench-panel-alignment-choice-end = end

setting-workbench-panel-alignment-choice-justify = justify

setting-workbench-panel-alignment-choice-start = start
