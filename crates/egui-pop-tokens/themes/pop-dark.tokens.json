  "clear": {"$type": "color", "$value": "#00000000", "$description": "No colour at all."},
  "transparent": {"$type": "color", "$value": "{clear}", "$description": "Nothing painted: a part that shows what is behind it."},
  "black": {"$type": "color", "$value": "#000000", "$description": "Black, opaque."},
  "scrim": {"$type": "color", "$value": "{black}", "$description": "What a backdrop dims the interface with, at opacity.scrim."},
  "surface": {
    "$type": "color",
    "canvas": {"$value": "{gray.1}", "$description": "Behind documents, images and graphs."},
    "panel": {"$value": "{gray.2}", "$description": "Panels and side bars: the default background."},
    "raised": {"$value": "{gray.4}", "$description": "Controls at rest: buttons, combo boxes."},
    "hover": {"$value": "{gray.5}", "$description": "A control under the pointer."},
    "active": {"$value": "{gray.6}", "$description": "A control being pressed or dragged."},
    "overlay": {"$value": "{gray.3}", "$description": "Windows, menus, popups and dialogs."},
    "sunken": {"$value": "{gray.0}", "$description": "Text fields and wells: the deepest background."}
  },
  "text": {
    "$type": "color",
    "default": {"$value": "{gray.11}", "$description": "Ordinary text."},
    "muted": {"$value": "{gray.10}", "$description": "Secondary text, hints, placeholders."},
    "strong": {"$value": "{gray.12}", "$description": "Titles, emphasis, text under the pointer."},
    "on-accent": {"$value": "{gold.contrast}", "$description": "Text on an accent fill."}
  },
  "border": {
    "$type": "color",
    "default": {"$value": "{gray.6}", "$description": "Outlines and separators (decorative)."},
    "strong": {"$value": "{gray.9}", "$description": "Outlines that must be seen: 3:1 against panels."}
  },
  "accent": {
    "$type": "color",
    "default": {"$value": "{gold.9}", "$description": "Primary actions, checked and selected states, links."},
    "hover": {"$value": "{gold.10}", "$description": "The accent under the pointer."},
    "active": {"$value": "{gold.8}", "$description": "The accent being pressed."},
    "subtle": {"$value": "{gold.3}", "$description": "A quiet accent background."}
  },
  "danger": {"$type": "color", "$value": "{red.11}", "$description": "Errors and destructive actions (readable as text)."},
  "warning": {"$type": "color", "$value": "{amber.11}", "$description": "Warnings (readable as text)."},
  "success": {"$type": "color", "$value": "{green.11}", "$description": "Success (readable as text)."},
  "info": {"$type": "color", "$value": "{blue.11}", "$description": "Information (readable as text)."},
  "focus": {
    "$type": "color",
    "ring": {"$value": "{accent.default}", "$description": "The keyboard focus outline."}
  },
  "selection": {"$type": "color", "$value": "{gold.5}", "$description": "Selected text and items, under ordinary text."},
