{
  "$extends": "pop-dark",
  "$description": "The dark theme with black surfaces, white text, strong outlines and larger body text.",
  "surface": {
    "$type": "color",
    "canvas": {"$value": "#000000"},
    "panel": {"$value": "#000000"},
    "overlay": {"$value": "#000000"},
    "sunken": {"$value": "#000000"},
    "raised": {"$value": "{gray.3}"},
    "hover": {"$value": "{gray.5}"},
    "active": {"$value": "{gray.7}"}
  },
  "text": {
    "$type": "color",
    "default": {"$value": "{gray.12}"},
    "muted": {"$value": "{gray.11}"},
    "strong": {"$value": "#ffffff"}
  },
  "border": {
    "$type": "color",
    "default": {"$value": "{gray.6}"},
    "strong": {"$value": "{gray.12}"}
  },
  "button": {
    "border": {"$type": "color", "$value": "{border.strong}", "$description": "Every control outlined."}
  },
  "font": {
    "size": {
      "$type": "dimension",
      "body": {"$value": {"value": 15, "unit": "px"}},
      "mono": {"$value": {"value": 14, "unit": "px"}},
      "small": {"$value": {"value": 12, "unit": "px"}}
    }
  }
}
