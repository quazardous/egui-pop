{
  "$description": "The `status-indicator` component of the default kit (docs/kit.md), layered into pop-dark.",
  "status-indicator": {
    "$description": "A status bar indicator (a kit component, colours only): its text by tone (rest is quiet), its progress line along its bottom: the track in border-color, the fill in indicator-color, indicator-size thick.",
    "shape": {"$type": "string", "$value": "plain"},
    "rest": {
      "text": {"$type": "color", "$value": "{text.muted}"},
      "border-color": {"$type": "color", "$value": "{border.default}"},
      "indicator-color": {"$type": "color", "$value": "{text.muted}"},
      "indicator-size": {"$type": "dimension", "$value": "{progress-line.height}"}
    },
    "tone": {
      "accent": {
        "text": {"$type": "color", "$value": "{accent.default}"},
        "indicator-color": {"$type": "color", "$value": "{accent.default}"}
      },
      "success": {
        "text": {"$type": "color", "$value": "{success}"},
        "indicator-color": {"$type": "color", "$value": "{success}"}
      },
      "warning": {
        "text": {"$type": "color", "$value": "{warning}"},
        "indicator-color": {"$type": "color", "$value": "{warning}"}
      },
      "danger": {
        "text": {"$type": "color", "$value": "{danger}"},
        "indicator-color": {"$type": "color", "$value": "{danger}"}
      }
    }
  }
}
