{
  "$description": "The `toast` component of the default kit (docs/kit.md), layered into pop-dark.",
  "toast": {
    "$description": "A toast's frame (a kit component); its level's tone is the icon's.",
    "shape": {"$type": "string", "$value": "card"},
    "padding-x": {"$type": "dimension", "$value": "{space.m}"},
    "padding-y": {"$type": "dimension", "$value": "{space.m}"},
    "width": {"$type": "dimension", "$value": "{size.toast.width}"},
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.overlay}"},
      "border-color": {"$type": "color", "$value": "{border.strong}"},
      "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}},
      "radius": {"$type": "dimension", "$value": "{radius.widget}"},
      "text": {"$type": "color", "$value": "{text.default}"}
    }
  }
}
