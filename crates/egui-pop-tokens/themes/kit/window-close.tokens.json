    "shape": {"$type": "string", "$value": "plain"},
    "width": {"$type": "dimension", "$value": "{size.titlebar.button}"},
    "rest": {
      "fill": {"$type": "color", "$value": "{transparent}"},
      "text": {"$type": "color", "$value": "{text.muted}"}
