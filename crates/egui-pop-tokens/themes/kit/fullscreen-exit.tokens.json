{
  "$description": "The `fullscreen-exit` component of the default kit (docs/kit.md), layered into pop-dark.",
  "fullscreen-exit": {
    "$description": "The strip at the top of a full screen window, its way out (a kit component).",
    "shape": {"$type": "string", "$value": "card"},
    "padding-x": {"$type": "dimension", "$value": "{space.m}"},
    "padding-y": {"$type": "dimension", "$value": "{space.m}"},
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.overlay}"},
      "border-color": {"$type": "color", "$value": "{border.default}"},
      "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}},
      "radius": {"$type": "dimension", "$value": "{radius.window}"}
    }
  }
}
