{
  "$description": "The `tab-bar` component of the default kit (docs/kit.md), layered into pop-dark.",
  "tab-bar": {
    "$description": "The bar behind a row of tabs (a kit component).",
    "shape": {"$type": "string", "$value": "plain"},
    "height": {"$type": "dimension", "$value": "{size.control.height}"},
    "indicator-side": {"$type": "string", "$value": "bottom"},
    "rest": {
      "fill": {"$type": "color", "$value": "{surface.sunken}"},
      "border-color": {"$type": "color", "$value": "{border.default}"},
      "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}}
    }
  }
}
