{
  "kind": "pointer-profile",
  "version": 1,
  "id": "photoshop",
  "title": "Photoshop",
  "description": "The wheel scrolls, Ctrl with the wheel scrolls sideways and Alt with it zooms, a drag pans like the Hand tool, Shift steps a value coarser and Alt finer, as in Photoshop.",
  "options": {
    "slider_wheel": "guarded",
    "image_double_click": "nothing"
  },
  "input": {
    "zoom": "Ctrl",
    "horizontal_scroll": "Shift",
    "vertical_scroll": "Alt"
  },
  "bindings": [
    {
      "keys": "Wheel",
      "command": "gesture.image.pan",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Ctrl+Wheel",
      "command": "gesture.image.pan_x",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Alt+Wheel",
      "command": "gesture.image.zoom",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Scroll",
      "command": "gesture.image.pan",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Ctrl+Scroll",
      "command": "gesture.image.zoom",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Pinch",
      "command": "gesture.image.zoom",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "PrimaryDrag",
      "command": "gesture.image.pan",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Wheel",
      "command": "gesture.graph.pan",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Ctrl+Wheel",
      "command": "gesture.graph.pan_x",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Alt+Wheel",
      "command": "gesture.graph.zoom",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Scroll",
      "command": "gesture.graph.pan",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Ctrl+Scroll",
      "command": "gesture.graph.zoom",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Pinch",
      "command": "gesture.graph.zoom",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Alt+PrimaryDrag",
      "command": "gesture.value.fine",
      "scope": "surface:widget.value"
    },
    {
      "keys": "Shift+PrimaryDrag",
      "command": "gesture.value.coarse",
      "scope": "surface:widget.value"
    },
    {
      "keys": "Ctrl+PrimaryDrag",
      "command": "gesture.sections.pull",
      "scope": "surface:widget.sections"
    }
  ]
}
