{
  "kind": "pointer-profile",
  "version": 1,
  "id": "trackpad",
  "title": "Trackpad",
  "description": "Two fingers pan, a pinch zooms, nothing needs a middle button and scrolling never changes a value.",
  "options": {
    "slider_wheel": "guarded",
    "image_double_click": "fit"
  },
  "input": {
    "zoom": "Ctrl",
    "horizontal_scroll": "Shift",
    "vertical_scroll": "Alt"
  },
  "bindings": [
    {
      "keys": "Scroll",
      "command": "gesture.image.pan",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Wheel",
      "command": "gesture.image.pan",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Ctrl+Scroll",
      "command": "gesture.image.zoom",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Ctrl+Wheel",
      "command": "gesture.image.zoom",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Pinch",
      "command": "gesture.image.zoom",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "PrimaryDrag",
      "command": "gesture.image.pan",
      "scope": "surface:canvas.image"
    },
    {
      "keys": "Scroll",
      "command": "gesture.graph.pan",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Wheel",
      "command": "gesture.graph.pan",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Ctrl+Scroll",
      "command": "gesture.graph.zoom",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Ctrl+Wheel",
      "command": "gesture.graph.zoom",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Pinch",
      "command": "gesture.graph.zoom",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "PrimaryDoubleClick",
      "command": "gesture.graph.fit",
      "scope": "surface:canvas.graph"
    },
    {
      "keys": "Ctrl+Wheel",
      "command": "gesture.value.step",
      "scope": "surface:widget.value"
    },
    {
      "keys": "Ctrl+PrimaryDrag",
      "command": "gesture.value.fine",
      "scope": "surface:widget.value"
    },
    {
      "keys": "Shift+PrimaryDrag",
      "command": "gesture.value.coarse",
      "scope": "surface:widget.value"
    },
    {
      "keys": "Ctrl+PrimaryDrag",
      "command": "gesture.sections.pull",
      "scope": "surface:widget.sections"
    }
  ]
}
